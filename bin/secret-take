#!/bin/bash

# secret-take: move a secret into one or more projects' .env files.
#
# The secret comes from the clipboard, or from another .env file with --from.
# It is never printed, never passed as a command argument, and never needs to
# be typed or pasted into a chat. When it came from the clipboard, the clipboard
# is cleared afterwards and that one copy is removed from Omarchy's clipboard
# history; every other history entry is left as it was.

set -euo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}")
# shellcheck source=../lib/common.sh
. "${self%/*}/../lib/common.sh"

EXIT_USAGE=2
EXIT_NOT_IGNORED=3
EXIT_NO_KEY=4
EXIT_CANNOT_WRITE=5

usage() {
  cat <<'EOF'
Usage: secret-take NAME [--file PATH]... [--from PATH] [--wait [SECONDS]]
                        [--ignore] [--json]

  NAME            the variable name to store, e.g. OPENROUTER_API_KEY
  --file PATH     a file to write (default: ./.env); repeat to save the same
                  key into several projects at once
  --from PATH     take NAME's value from this .env file instead of the
                  clipboard; the clipboard and its history are not touched
  --wait [SECS]   ask the person to copy the key, then take the next thing
                  copied that looks like one (default wait: 120 seconds)
  --ignore        when git does not ignore a target file, add it to the
                  .gitignore beside it first, instead of refusing
  --json          report the outcome as one JSON object, and send no
                  desktop notification

Without --wait or --from, the key must already be on the clipboard.
Nothing is written unless every target file can be written safely.

Exit: 0 saved, 2 bad usage, 3 a target file is not ignored by git (or is
      already tracked by it), 4 no usable key was found, 5 a target file or
      its folder cannot be written.
EOF
}

name=
files=()
from=
wait_s=
ignore=0
json=0

# Refuse: a message for a person on stderr, and with --json the same thing as
# an object on stdout. Arguments after the message are the files concerned.
die() {
  local code=$1 kind=$2 message=$3
  shift 3
  echo "secret-take: $message" >&2
  if ((json)); then
    jq -cn --arg error "$kind" --arg message "$message" \
      '{ok: false, error: $error, message: $message, files: $ARGS.positional}' --args "$@"
  fi
  exit "$code"
}

while (($#)); do
  case $1 in
  --file)
    [[ -n ${2:-} ]] || die $EXIT_USAGE usage "--file needs a path"
    files+=("$2")
    shift 2
    ;;
  --from)
    [[ -n ${2:-} ]] || die $EXIT_USAGE usage "--from needs a path"
    from=$2
    shift 2
    ;;
  --wait)
    wait_s=120
    shift
    if [[ ${1:-} =~ ^[0-9]+$ ]]; then
      wait_s=$1
      shift
    fi
    ;;
  --ignore)
    ignore=1
    shift
    ;;
  --json)
    json=1
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*) die $EXIT_USAGE usage "unknown option: $1" ;;
  *)
    [[ -z $name ]] || die $EXIT_USAGE usage "one name at a time"
    name=$1
    shift
    ;;
  esac
done

[[ -n $name ]] || { usage >&2; exit $EXIT_USAGE; }
is_name "$name" || die $EXIT_USAGE usage "not a variable name: $name"
[[ -z $from || -z $wait_s ]] || die $EXIT_USAGE usage "--from and --wait do not go together"
((${#files[@]})) || files=(.env)

notify() {
  ((json)) && return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send --app-name="secret-take" "$1" "${2:-}" 2>/dev/null || true
}

# Resolve every target and how git treats it before reading any key, so a
# refusal costs no copy and leaves nothing half done.
targets=()
states=()
for f in "${files[@]}"; do
  t=$(resolve_file "$f") || die $EXIT_USAGE usage "no such directory: $(dirname -- "$f")"
  for seen in ${targets[@]+"${targets[@]}"}; do
    [[ $seen != "$t" ]] || continue 2
  done
  targets+=("$t")
  states+=("$(git_state "$t")")
done

# A file that is read-only was made so on purpose; it is not replaced.
locked=()
for t in "${targets[@]}"; do
  if [[ ! -w ${t%/*} || (-e $t && ! -w $t) ]]; then
    locked+=("$t")
  fi
done
if ((${#locked[@]})); then
  die $EXIT_CANNOT_WRITE cannot-write "cannot write ${locked[*]} (the file or its folder is read-only). Nothing was written." "${locked[@]}"
fi

tracked=()
unignored=()
for i in "${!targets[@]}"; do
  case ${states[i]} in
  tracked) tracked+=("${targets[i]}") ;;
  not-ignored) unignored+=("${targets[i]}") ;;
  esac
done

if ((${#tracked[@]})); then
  die $EXIT_NOT_IGNORED tracked "git already tracks ${tracked[*]}, so a key saved there would be committed, and adding it to .gitignore would not change that. Run 'git rm --cached' on it first. Nothing was written." "${tracked[@]}"
fi
if ((${#unignored[@]} && !ignore)); then
  die $EXIT_NOT_IGNORED not-ignored "git does not ignore ${unignored[*]}, so the key could be committed. Add it to .gitignore or pass --ignore, then run this again. Nothing was written." "${unignored[@]}"
fi

source=clipboard
if [[ -n $from ]]; then
  source=file
  from=$(resolve_file "$from") || die $EXIT_USAGE usage "no such file: $from"
  [[ -f $from ]] || die $EXIT_NO_KEY not-found "no such file: $from. Nothing was written." "$from"
  env_get "$from" "$name" || die $EXIT_NO_KEY not-found "$name is not in $from. Nothing was written." "$from"
  value=$ENV_VALUE
  [[ -n $value ]] || die $EXIT_NO_KEY not-found "$name is empty in $from. Nothing was written." "$from"
  [[ $value != *[[:space:]]* && $value != *\'* ]] ||
    die $EXIT_NO_KEY not-found "$name in $from has a space or a single quote in it, which this tool does not carry. Nothing was written." "$from"
elif [[ -n $wait_s ]]; then
  already=$(clip_read)
  notify "Copy $name now" "Waiting ${wait_s}s. It will be saved to ${targets[*]}."
  deadline=$((SECONDS + wait_s))
  while :; do
    value=$(clip_read)
    if [[ $value != "$already" ]] && plausible "$value"; then
      break
    fi
    if ((SECONDS >= deadline)); then
      notify "Gave up waiting for $name" "Nothing that looks like a key was copied."
      die $EXIT_NO_KEY no-key "nothing that looks like a key was copied in ${wait_s}s. Nothing was written."
    fi
    sleep 0.3
  done
else
  value=$(clip_read)
  plausible "$value" ||
    die $EXIT_NO_KEY no-key "the clipboard does not hold something that looks like a key (it is empty, has spaces or several lines, has a single quote, or is under 8 characters). Nothing was written."
fi

# Add the files git would otherwise commit to the .gitignore beside them, and
# check that git now ignores each one, before any key is written.
ignore_added=()
for i in "${!targets[@]}"; do
  ignore_added+=(0)
  [[ ${states[i]} == not-ignored ]] || continue
  t=${targets[i]}
  gi="${t%/*}/.gitignore"
  if [[ -s $gi && -n $(tail -c 1 -- "$gi") ]]; then
    printf '\n' >>"$gi"
  fi
  printf '%s\n' "${t##*/}" >>"$gi"
  states[i]=$(git_state "$t")
  [[ ${states[i]} == ignored ]] ||
    die $EXIT_NOT_IGNORED not-ignored "added ${t##*/} to $gi but git still does not ignore $t (another rule un-ignores it). No key was written." "$t"
  ignore_added[i]=1
done

env_line "$name" "$value"
line=$ENV_LINE

tmp=
htmp=
trap 'rm -f -- ${tmp:+"$tmp"} ${htmp:+"$htmp"}' EXIT

# Writes $line into one file through a temp file beside it. Sets $action.
write_env() {
  local file=$1 existing old replaced=0 had_value=0
  tmp=$(mktemp -- "${file%/*}/.secret-take.XXXXXX")
  action=added
  if [[ -e $file ]]; then
    while IFS= read -r existing || [[ -n $existing ]]; do
      if [[ $existing =~ ^[[:space:]]*(export[[:space:]]+)?$name[[:space:]]*=(.*)$ ]]; then
        # Keep the first occurrence's place and its export prefix; drop repeats.
        ((replaced)) || printf '%s%s\n' "${BASH_REMATCH[1]-}" "$line"
        replaced=1
        # A line that held no value was a placeholder being filled in.
        old=${BASH_REMATCH[2]//[[:space:]]/}
        [[ -n $old && $old != '""' && $old != "''" && $old != \#* ]] && had_value=1
      else
        printf '%s\n' "$existing"
      fi
    done <"$file" >"$tmp"
    if ((replaced && had_value)); then
      action=replaced
    elif ((replaced)); then
      action=filled
    else
      printf '%s\n' "$line" >>"$tmp"
    fi
    chmod --reference="$file" -- "$tmp"
  else
    printf '%s\n' "$line" >"$tmp"
    chmod 600 -- "$tmp"
  fi
  mv -f -- "$tmp" "$file"
  tmp=
}

actions=()
for t in "${targets[@]}"; do
  write_env "$t"
  actions+=("$action")
done

clipboard=untouched
history=untouched
removed=

if [[ $source == clipboard ]]; then
  # Clear the clipboard only if it still holds the key, so a newer copy survives.
  if [[ $(clip_read) == "$value" ]]; then
    if wl-copy --clear 2>/dev/null; then
      clipboard=cleared
    else
      clipboard=failed
    fi
  else
    clipboard=changed
  fi

  # Take this one copy out of Omarchy's clipboard history. The shell rewrites
  # that file on every copy, so the edit is made only if the file is still the
  # one that was read; otherwise it is read again. Nothing else in it changes.
  hist="$HOME/.local/state/omarchy/clipboard-history.json"

  # 0 looked (sets $removed), 1 the file changed underneath, 2 could not look.
  scrub_once() {
    local sig before after
    sig=$(stat -c '%i:%s:%y' -- "$hist" 2>/dev/null) || return 2
    htmp=$(mktemp -- "$hist.XXXXXX") || return 2
    if ! printf '%s' "$value" | jq --rawfile v /dev/stdin '
        ($v | gsub("^\\s+|\\s+$"; "")) as $secret
        | {before: length,
           kept: map(select((.type == "text" and ((.text // "") | gsub("^\\s+|\\s+$"; "")) == $secret) | not))}
      ' "$hist" >"$htmp" 2>/dev/null; then
      rm -f -- "$htmp"
      return 2
    fi
    before=$(jq '.before' "$htmp")
    after=$(jq '.kept | length' "$htmp")
    if ((after == before)); then
      rm -f -- "$htmp"
      return 0
    fi
    jq '.kept' "$htmp" >"$htmp.new" && mv -f -- "$htmp.new" "$htmp"
    chmod --reference="$hist" -- "$htmp"
    if [[ $(stat -c '%i:%s:%y' -- "$hist" 2>/dev/null) != "$sig" ]]; then
      rm -f -- "$htmp"
      return 1
    fi
    mv -f -- "$htmp" "$hist"
    removed=$((removed + before - after))
    return 0
  }

  if [[ ! -f $hist ]]; then
    history=no-file
  elif ! command -v jq >/dev/null 2>&1; then
    history=unchecked
  else
    # After --wait the history may not have recorded the copy yet, so look
    # again for a few seconds before concluding it is not there.
    tries=5
    [[ -n $wait_s ]] && tries=10
    removed=0
    history=none
    for ((i = 0; i < tries; i++)); do
      rc=0
      scrub_once || rc=$?
      if ((rc == 2)); then
        history=unchecked
        removed=
        break
      fi
      if ((rc == 0)); then
        if ((removed > 0)); then
          history=removed
          break
        fi
        [[ -n $wait_s ]] || break
      fi
      ((i + 1 < tries)) && sleep 0.3
    done
    if ((rc == 1)); then
      history=unchecked
      removed=
    fi
  fi
fi

describe_key "$value"

case $clipboard in
cleared) clipboard_said="cleared" ;;
failed) clipboard_said="STILL HOLDS THE KEY (could not clear it)" ;;
changed) clipboard_said="left alone (it had already changed)" ;;
*) clipboard_said="not touched (the key came from $from)" ;;
esac
case $history in
removed)
  history_said="removed $removed entry"
  ((removed > 1)) && history_said="removed $removed entries"
  ;;
none) history_said="no matching entry found" ;;
no-file) history_said="no history file at $hist" ;;
unchecked) history_said="NOT CHECKED (could not read or safely edit the history file)" ;;
*) history_said="not touched" ;;
esac

if ((json)); then
  # The hint is a few characters of the key, so it goes in on a pipe like the
  # key itself, never as an argument.
  {
    printf '%s' "$KEY_HINT" | jq -Rs .
    for i in "${!targets[@]}"; do
      jq -cn --arg file "${targets[i]}" --arg action "${actions[i]}" --arg git "${states[i]}" \
        --argjson added "${ignore_added[i]}" \
        '{file: $file, action: $action, git: $git, ignoreAdded: ($added == 1)}'
    done
  } | jq -cs --arg name "$name" --arg source "$source" \
    --argjson length "${#value}" --arg clipboard "$clipboard" --arg history "$history" \
    --arg removed "$removed" \
    '{ok: true, name: $name, source: $source, length: $length, hint: .[0], results: .[1:],
      clipboard: $clipboard, history: $history,
      historyRemoved: (if $removed == "" then null else ($removed | tonumber) end)}'
else
  for i in "${!targets[@]}"; do
    said=${actions[i]}
    [[ $said == filled ]] && said="filled in"
    echo "$said $name in ${targets[i]} (${#value} characters, starts \"$KEY_HINT\")"
    ((ignore_added[i])) && echo "gitignore: added ${targets[i]##*/} to ${targets[i]%/*}/.gitignore"
  done
  echo "clipboard: $clipboard_said"
  echo "history: $history_said"
  where=${targets[0]}
  ((${#targets[@]} > 1)) && where="${#targets[@]} files"
  notify "Saved $name" "$where · clipboard $clipboard_said · history: $history_said"
fi
exit 0
