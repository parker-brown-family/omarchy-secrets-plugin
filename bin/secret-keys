#!/bin/bash

# secret-keys: say where keys are, without ever showing one.
#
# Everything here reports names and places only. The one command that moves a
# value, `copy`, puts it on the clipboard marked as sensitive, which Omarchy's
# clipboard history skips.

set -euo pipefail

self=$(readlink -f -- "${BASH_SOURCE[0]}")
# shellcheck source=../lib/common.sh
. "${self%/*}/../lib/common.sh"

usage() {
  cat <<'EOF'
Usage: secret-keys COMMAND

  has NAME [--file PATH]    exit 0 when NAME has a value in the file
                            (default ./.env), 1 when it does not
  names [--file PATH]       the names in the file, one per line
  peek                      what is on the clipboard, as JSON: whether it looks
                            like a key, its length, a likely name; never the key
  scan [--git]              every project under the search folders and the
                            names in its .env files, as JSON; --git adds how
                            git treats each file
  check PATH...             how git treats each file, as JSON
  copy NAME --file PATH     put NAME's value on the clipboard, marked sensitive
  folders                   the search folders and the depth, as JSON
  folders add PATH          search PATH as well
  folders remove PATH       stop searching PATH
  folders depth N           look N folders deep for nested projects (1 to 8)
  dirs PATH                 the folders inside PATH, as JSON

Search folders are kept in ~/.config/omarchy-secrets/config.json.
EOF
}

die() {
  echo "secret-keys: $*" >&2
  exit 2
}

config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-secrets/config.json"
DEFAULT_ROOTS='["~/Work","~/Projects","~/Code","~/src"]'
DEFAULT_DEPTH=4

# Folder names that hold dependencies or build output, never a project of
# their own. Hidden folders are skipped as well.
SKIP=(node_modules target venv dist build vendor __pycache__ Pods)

roots=()
depth=$DEFAULT_DEPTH
configured=0

expand() {
  local p=$1
  [[ $p == "~" ]] && p=$HOME
  [[ $p == "~/"* ]] && p=$HOME/${p#"~/"}
  printf '%s\n' "$p"
}

# The short form kept in the config file, so it reads the same on any machine.
contract() {
  local p=$1
  if [[ $p == "$HOME" ]]; then
    p="~"
  elif [[ $p == "$HOME"/* ]]; then
    p="~/${p#"$HOME"/}"
  fi
  printf '%s\n' "$p"
}

load_config() {
  local raw=$DEFAULT_ROOTS line d
  if [[ -f $config ]] && jq -e 'type == "object"' "$config" >/dev/null 2>&1; then
    configured=1
    raw=$(jq -c 'if (.roots | type) == "array" then .roots else null end' "$config")
    [[ $raw != null ]] || raw=$DEFAULT_ROOTS
    d=$(jq -r '.depth // empty' "$config")
    [[ $d =~ ^[1-8]$ ]] && depth=$d
  fi
  roots=()
  while IFS= read -r line; do
    [[ -n $line ]] && roots+=("$(expand "$line")")
  done < <(jq -r '.[] | strings' <<<"$raw")
  return 0
}

save_config() {
  local r
  mkdir -p -- "${config%/*}"
  for r in ${roots[@]+"${roots[@]}"}; do
    contract "$r"
  done | jq -Rn --argjson depth "$depth" '{roots: [inputs], depth: $depth}' >"$config.tmp"
  mv -f -- "$config.tmp" "$config"
}

roots_json() {
  local r
  for r in ${roots[@]+"${roots[@]}"}; do
    printf '%s\t%s\n' "$([[ -d $r ]] && echo 1 || echo 0)" "$r"
  done | jq -Rn '[inputs | split("\t") | {path: .[1], exists: (.[0] == "1")}]'
}

# Lines of "K <tab> file <tab> NAME <tab> 1|0" for the given files on stdin
# (NUL separated). The last field says whether the name has a value. The value
# itself is never printed.
names_tsv() {
  xargs -0 -r awk '
    {
      line = $0
      sub(/\r$/, "", line)
      if (match(line, /^[ \t]*(export[ \t]+)?[A-Za-z_][A-Za-z0-9_]*[ \t]*=/)) {
        head = substr(line, RSTART, RLENGTH)
        rest = substr(line, RSTART + RLENGTH)
        sub(/^[ \t]*(export[ \t]+)?/, "", head)
        sub(/[ \t]*=$/, "", head)
        gsub(/^[ \t]+|[ \t]+$/, "", rest)
        filled = !(rest == "" || rest == "\"\"" || rest == "\047\047" || rest ~ /^#/)
        print "K\t" FILENAME "\t" head "\t" (filled ? 1 : 0)
      }
    }'
}

# The folder holding the nearest .git above a path, found without running git.
repo_root() {
  local dir=$1
  while [[ -n $dir && $dir != / ]]; do
    if [[ -e $dir/.git ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir=${dir%/*}
  done
  return 1
}

# "G <tab> file <tab> state <tab> other-vcs" for every file named on stdin, one
# per line. git is asked twice per repository, not three times per file.
git_rows() {
  local f root dir n=0 list
  dir=$(mktemp -d)
  declare -A slot=()
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    if root=$(repo_root "${f%/*}"); then
      if [[ -z ${slot[$root]:-} ]]; then
        n=$((n + 1))
        slot[$root]=$n
        printf '%s\n' "$root" >"$dir/$n.root"
      fi
      printf '%s\n' "$f" >>"$dir/${slot[$root]}.files"
    else
      printf 'G\t%s\tnot-git\t%s\n' "$f" "$(other_vcs "${f%/*}")"
    fi
  done
  for list in "$dir"/*.files; do
    [[ -e $list ]] || continue
    (
      root=$(<"${list%.files}.root")
      mapfile -t files <"$list"
      tracked=$(git -C "$root" ls-files --full-name -- "${files[@]}" 2>/dev/null || true)
      ignored=$(git -C "$root" check-ignore -- "${files[@]}" 2>/dev/null || true)
      for f in "${files[@]}"; do
        if grep -qxF -- "${f#"$root"/}" <<<"$tracked"; then
          state=tracked
        elif grep -qxF -- "$f" <<<"$ignored"; then
          state=ignored
        else
          state=not-ignored
        fi
        printf 'G\t%s\t%s\t\n' "$f" "$state"
      done >"$list.out"
    ) &
  done
  wait
  cat "$dir"/*.out 2>/dev/null || true
  rm -rf -- "$dir"
}

cmd_scan() {
  local with_git=0 root work prune=() s
  [[ ${1:-} == --git ]] && with_git=1
  load_config

  prune=(-name '.*')
  for s in "${SKIP[@]}"; do prune+=(-o -name "$s"); done

  work=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf -- '$work'" EXIT
  : >"$work/envs"

  # One search per folder, all at once, so the wait is the slowest folder's
  # and not the sum of them.
  local n=0
  for root in ${roots[@]+"${roots[@]}"}; do
    [[ -d $root ]] || continue
    n=$((n + 1))
    (
      # Folders directly inside a search folder are projects, with or without keys.
      find "$root" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf 'D\t%T@\t%p\n' >"$work/rows.$n" 2>/dev/null || true
      # Deeper down, a folder is a project only when it holds a .env file.
      # Editor leftovers and files in other formats are not .env files.
      find "$root" -maxdepth $((depth + 1)) \
        \( -type d \( "${prune[@]}" \) ! -samefile "$root" -prune \) -o \
        \( -type f \( -name .env -o -name '.env.*' \) \
        ! -name '*.sw?' ! -name '*~' ! -name '*.toml' ! -name '*.json' ! -name '*.yaml' ! -name '*.yml' \
        ! -name '*.enc' ! -name '*.gpg' ! -name '*.age' ! -name '*'$'\t''*' ! -name '*'$'\n''*' -print0 \) >"$work/envs.$n" 2>/dev/null || true
    ) &
  done
  wait
  : >"$work/rows"
  for ((s = 1; s <= n; s++)); do
    cat "$work/rows.$s" >>"$work/rows"
    cat "$work/envs.$s" >>"$work/envs"
  done

  tr '\0' '\n' <"$work/envs" >"$work/list"
  sed 's/^/E\t/' "$work/list" >>"$work/rows"
  names_tsv <"$work/envs" >>"$work/rows" || true

  # Modified times of the folders that hold a .env, for the newest-first order.
  sed 's|/[^/]*$||' "$work/list" | sort -u | xargs -r -d '\n' stat -c $'M\t%Y\t%n' -- >>"$work/rows" 2>/dev/null || true

  if ((with_git)); then
    git_rows <"$work/list" >>"$work/rows"
  fi

  jq -Rn --argjson roots "$(roots_json)" --argjson depth "$depth" \
    --argjson configured "$configured" --arg config "$config" '
    def dirname: sub("/[^/]*$"; "");
    def basename: sub(".*/"; "");
    def example: test("\\.(example|sample|template|tpl|dist|defaults?)$");
    def backup: test("\\.(bak|backup|old|orig|save)(\\.|$)");
    [inputs | split("\t")] as $rows
    | (reduce ($rows[] | select(.[0] == "K")) as $r ({}; .[$r[1]] += [{name: $r[2], set: ($r[3] == "1")}])) as $names
    | (reduce ($rows[] | select(.[0] == "G")) as $r ({}; .[$r[1]] = {git: $r[2], vcs: (if $r[3] == "" then null else $r[3] end)})) as $git
    | (reduce ($rows[] | select(.[0] == "D")) as $r ({}; .[$r[2]] = ($r[1] | tonumber | floor))) as $top
    | (reduce ($rows[] | select(.[0] == "M")) as $r ({}; .[$r[2]] = ($r[1] | tonumber))) as $nested
    | (reduce ($rows[] | select(.[0] == "E")) as $r ({}; .[$r[1] | dirname] += [$r[1]])) as $files
    | ($roots | map(.path)) as $rootpaths
    | ([($top | keys[]), ($files | keys[])] | unique) as $dirs
    | {
        config: $config,
        configured: ($configured == 1),
        depth: $depth,
        roots: $roots,
        projects: (
          $dirs | map(. as $dir
            | ([$rootpaths[] | . as $r | select($dir == $r or ($dir | startswith($r + "/")))] | sort_by(length) | last) as $root
            | {
                dir: $dir,
                root: $root,
                label: (if $root == null or $dir == $root then ($dir | basename) else $dir[($root | length) + 1:] end),
                mtime: ($top[$dir] // $nested[$dir] // 0),
                files: (($files[$dir] // []) | map(. as $f | ($f | basename) as $base
                  | {file: $f, base: $base, example: ($base | example), backup: (($base | example | not) and ($base | backup)),
                     names: ($names[$f] // [])}
                    + (if $git[$f] then $git[$f] else {} end))
                  | sort_by(.example, .backup, .base))
              })
          | sort_by(-.mtime, .label)
        )
      }' <"$work/rows"
}

cmd_check() {
  local f t state vcs
  (($#)) || die "check needs at least one path"
  for f in "$@"; do
    t=$(resolve_file "$f") || { jq -cn --arg file "$f" '{file: $file, error: "no such directory"}'; continue; }
    state=$(git_state "$t")
    vcs=
    [[ $state == not-git ]] && vcs=$(other_vcs "${t%/*}")
    jq -cn --arg file "$t" --arg git "$state" --arg vcs "$vcs" --arg exists "$([[ -e $t ]] && echo 1 || echo 0)" \
      '{file: $file, exists: ($exists == "1"), git: $git, vcs: (if $vcs == "" then null else $vcs end)}'
  done | jq -cs .
}

cmd_peek() {
  local value why
  value=$(clip_read)
  why=$(why_not_a_key "$value")
  if [[ -n $why ]]; then
    jq -cn --arg reason "$why" '{ok: false, reason: $reason}'
    return 0
  fi
  describe_key "$value"
  jq -cn --argjson length "${#value}" --arg hint "$KEY_HINT" --arg guess "$KEY_GUESS" \
    '{ok: true, length: $length, hint: $hint, guess: (if $guess == "" then null else $guess end)}'
}

file_arg=.env
take_file_arg() {
  rest=()
  while (($#)); do
    case $1 in
    --file)
      [[ -n ${2:-} ]] || die "--file needs a path"
      file_arg=$2
      shift 2
      ;;
    *)
      rest+=("$1")
      shift
      ;;
    esac
  done
}

cmd_has() {
  take_file_arg "$@"
  ((${#rest[@]} == 1)) || die "has needs one NAME"
  is_name "${rest[0]}" || die "not a variable name: ${rest[0]}"
  [[ -f $file_arg ]] || exit 1
  env_get "$file_arg" "${rest[0]}" || exit 1
  [[ -n $ENV_VALUE ]] || exit 1
  exit 0
}

cmd_names() {
  take_file_arg "$@"
  [[ -f $file_arg ]] || die "no such file: $file_arg"
  printf '%s\0' "$file_arg" | names_tsv | cut -f3
}

cmd_copy() {
  take_file_arg "$@"
  ((${#rest[@]} == 1)) || die "copy needs one NAME"
  is_name "${rest[0]}" || die "not a variable name: ${rest[0]}"
  [[ -f $file_arg ]] || die "no such file: $file_arg"
  env_get "$file_arg" "${rest[0]}" || die "${rest[0]} is not in $file_arg"
  [[ -n $ENV_VALUE ]] || die "${rest[0]} is empty in $file_arg"
  # Marked sensitive, so clipboard managers that honour the hint keep no copy.
  printf '%s' "$ENV_VALUE" | wl-copy --sensitive ||
    die "could not reach the clipboard"
  echo "copied ${rest[0]} from $file_arg to the clipboard (${#ENV_VALUE} characters, marked sensitive)"
}

cmd_folders() {
  local sub=${1:-} arg=${2:-} p r kept=()
  load_config
  case $sub in
  "") ;;
  add)
    [[ -n $arg ]] || die "folders add needs a path"
    p=$(realpath -m -- "$(expand "$arg")")
    [[ -d $p ]] || die "not a folder: $p"
    for r in ${roots[@]+"${roots[@]}"}; do
      [[ $r == "$p" ]] && { roots_and_depth; return 0; }
    done
    roots+=("$p")
    save_config
    ;;
  remove)
    [[ -n $arg ]] || die "folders remove needs a path"
    p=$(realpath -m -- "$(expand "$arg")")
    for r in ${roots[@]+"${roots[@]}"}; do
      [[ $r == "$p" ]] || kept+=("$r")
    done
    roots=(${kept[@]+"${kept[@]}"})
    save_config
    ;;
  depth)
    [[ $arg =~ ^[1-8]$ ]] || die "depth is a number from 1 to 8"
    depth=$arg
    save_config
    ;;
  *) die "unknown: folders $sub" ;;
  esac
  roots_and_depth
}

roots_and_depth() {
  jq -cn --argjson roots "$(roots_json)" --argjson depth "$depth" --arg config "$config" \
    '{config: $config, depth: $depth, roots: $roots}'
}

cmd_dirs() {
  local p
  p=$(realpath -m -- "$(expand "${1:-$HOME}")")
  [[ -d $p ]] || die "not a folder: $p"
  find "$p" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' 2>/dev/null | sort -f |
    jq -Rn --arg path "$p" --arg parent "$(dirname -- "$p")" '{path: $path, parent: $parent, dirs: [inputs]}'
}

cmd=${1:-}
(($#)) && shift
case $cmd in
has) cmd_has "$@" ;;
names) cmd_names "$@" ;;
peek) cmd_peek ;;
scan) cmd_scan "$@" ;;
check) cmd_check "$@" ;;
copy) cmd_copy "$@" ;;
folders) cmd_folders "$@" ;;
dirs) cmd_dirs "$@" ;;
-h | --help | help | "") usage ;;
*) die "unknown command: $cmd (try --help)" ;;
esac
